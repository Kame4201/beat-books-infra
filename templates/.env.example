# =============================================================================
# BeatTheBooks — Environment Variables Template
# =============================================================================
# Copy this file to .env at your repo root:  cp templates/.env.example .env
# Fill in real values. NEVER commit .env to git.
#
# See docs/operations/secret-management.md for full strategy.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. For Neon.tech, copy from the dashboard.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# -----------------------------------------------------------------------------
# The Odds API (Optional — only required when odds ingestion is enabled)
# -----------------------------------------------------------------------------
# API key from https://the-odds-api.com
# Leave blank in repos that don't fetch odds.
ODDS_API_KEY=

# -----------------------------------------------------------------------------
# Service URLs (Required for beat-books-api)
# -----------------------------------------------------------------------------
# URL to the prediction service (beat-books-model)
MODEL_SERVICE_URL=http://localhost:8002

# URL to the data service (beat-books-data)
DATA_SERVICE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Application Settings (Optional — have sensible defaults)
# -----------------------------------------------------------------------------
# Enable debug mode (true/false). Default: false
DEBUG=false

# Environment name (local/dev/stage/prod). Default: local
ENV=local
